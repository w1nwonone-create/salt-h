# Jeju-AgenticX 환경 변수 예시 — 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# 실제 Key 는 절대 저장소/제출물에 포함하지 마세요.

# auto(기본: Key 있으면 외부 LLM → 없으면 Ollama → 없으면 규칙 기반) | anthropic | ollama | rules
LLM_MODE=auto
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# 오프라인 모드(반출 제한 데이터 분석 시)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M

# 제주데이터허브 API (데이터 최신화용, 선택)
JEJU_DATAHUB_KEY=

# 센터 PC 실데이터 DuckDB 경로 (미지정 시 data/jeju.duckdb 예시 데이터)
JEJU_DB_PATH=
